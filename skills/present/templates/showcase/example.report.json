 "method": {
  "defs": [
   {
    "term": "WER",
    "html": "= (wrong + missing + extra words) / words in the reference, per segment, then averaged over segments. 7.40% means about 7 words in 100."
   },
   {
    "term": "Fully correct segment",
    "html": "a segment whose output matches the reference word for word after normalisation (case, punctuation, number format)."
   },
   {
    "term": "DER",
    "html": "= (missed speech + false speech + wrong speaker) / total speech time. Collar 0.25 s around each turn change."
   }
  ],
  "limits": [
   "Phone calls are 2.1 h; numbers for that group carry wide uncertainty.",
   "References were checked once by one annotator; no inter-annotator agreement was measured.",
   "All audio is read or dictated speech; spontaneous conversation is not covered."
  ],
